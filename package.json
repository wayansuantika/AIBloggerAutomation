{
  "name": "alamat-bali-autoblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute autoblog --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute autoblog --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
